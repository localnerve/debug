{
  "name": "@localnerve/debug",
  "version": "1.0.16",
  "description": "Tiny debug tool (~500 bytes) for terminal and browser inspired by debug-js/debug API.",
  "author": "Willy Brauner",
  "maintainers": [
    {
      "email": "alex@localnerve.com",
      "name": "Alex Grant",
      "url": "https://localnerve.com"
    }
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/localnerve/debug.git"
  },
  "keywords": [
    "debug",
    "debugger",
    "log",
    "logger",
    "console.log",
    "nodejs",
    "browser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch --sourcemap",
    "clean": "rm -rf ./dist && rm -rf tsconfig.tsbuildinfo",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "dev:example-browser": "cd examples/browser && npm i && npm run build && npm run dev",
    "dev:example-node": "cd examples/node && npm i && DEBUG=* node index.js && cd -",
    "pre-publish": "npm run build && npm test",
    "test": "node --test --experimental-test-coverage ./test/*.test.ts",
    "ncu": "find . -name 'node_modules' -prune -o -name 'package.json' -execdir ncu -u ';'",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.0.1",
    "@types/node": "^26.6.2",
    "size-limit": "^14.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": false
  },
  "size-limit": [
    {
      "name": "@localnerve/debug",
      "path": "dist/index.js",
      "limit": "665 B"
    }
  ],
  "allowScripts": {
    "esbuild": true
  }
}
